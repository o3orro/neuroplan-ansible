---
- name: Verify Helm binary
  ansible.builtin.command:
    cmd: /usr/local/bin/helm version --short
  register: helm_check
  changed_when: false
  become: false

- name: Add or update Argo Helm repository
  ansible.builtin.command:
    cmd: >
      /usr/local/bin/helm repo add
      {{ argocd_repo_name }}
      {{ argocd_repo_url }}
      --force-update
  changed_when: false
  become: false

- name: Check installed Argo CD Helm release
  ansible.builtin.command:
    cmd: >
      /usr/local/bin/helm list
      --namespace {{ argocd_namespace }}
      --filter '^{{ argocd_release_name }}$'
      --output json
  environment:
    KUBECONFIG: "{{ argocd_kubeconfig }}"
  register: argocd_release_check
  changed_when: false
  become: false
    
- name: Update Helm repositories
  ansible.builtin.command:
    cmd: /usr/local/bin/helm repo update
  changed_when: false
  become: false

- name: Install or upgrade Argo CD
  ansible.builtin.command:
    cmd: >
      /usr/local/bin/helm upgrade --install
      {{ argocd_release_name }}
      {{ argocd_chart }}
      --namespace {{ argocd_namespace }}
      --create-namespace
      --version {{ argocd_chart_version }}
      --wait
      --timeout 10m
  environment:
    KUBECONFIG: "{{ argocd_kubeconfig }}"
  register: argocd_helm_result
  when: >
    (argocd_release_check.stdout | from_json | length == 0)
    or
    (
      (argocd_release_check.stdout | from_json)[0].chart
      != 'argo-cd-' ~ argocd_chart_version
    )
  changed_when: true
  become: false

- name: Wait for Argo CD deployments
  ansible.builtin.command:
    cmd: >
      kubectl
      --kubeconfig={{ argocd_kubeconfig }}
      rollout status
      deployment/{{ item }}
      -n {{ argocd_namespace }}
      --timeout=600s
  loop:
    - argocd-applicationset-controller
    - argocd-dex-server
    - argocd-notifications-controller
    - argocd-redis
    - argocd-repo-server
    - argocd-server
  changed_when: false
  become: false

- name: Wait for Argo CD application controller
  ansible.builtin.command:
    cmd: >
      kubectl
      --kubeconfig={{ argocd_kubeconfig }}
      rollout status
      statefulset/argocd-application-controller
      -n {{ argocd_namespace }}
      --timeout=600s
  changed_when: false
  become: false

- name: Show Argo CD pods
  ansible.builtin.command:
    cmd: >
      kubectl
      --kubeconfig={{ argocd_kubeconfig }}
      get pods
      -n {{ argocd_namespace }}
      -o wide
  register: argocd_pods
  changed_when: false
  become: false

- name: Display Argo CD pods
  ansible.builtin.debug:
    var: argocd_pods.stdout_lines

- name: Create Argo CD Application manifest
  ansible.builtin.template:
    src: application.yaml.j2
    dest: /tmp/neuroplan-argocd-application.yaml
    mode: "0644"
  become: false

- name: Apply Argo CD Application
  ansible.builtin.command:
    cmd: >
      kubectl
      --kubeconfig={{ argocd_kubeconfig }}
      apply
      -f /tmp/neuroplan-argocd-application.yaml
  register: argocd_application_apply
  changed_when: >
    'created' in argocd_application_apply.stdout or
    'configured' in argocd_application_apply.stdout
  become: false

- name: Show Argo CD Application status
  ansible.builtin.command:
    cmd: >
      kubectl
      --kubeconfig={{ argocd_kubeconfig }}
      get application
      {{ argocd_application_name }}
      -n {{ argocd_namespace }}
  register: argocd_application_status
  changed_when: false
  become: false

- name: Display Argo CD Application status
  ansible.builtin.debug:
    var: argocd_application_status.stdout_lines
