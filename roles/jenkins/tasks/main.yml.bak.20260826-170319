---
# =========================================================
# Jenkins 설치
# =========================================================

- name: Install Jenkins dependencies
  ansible.builtin.dnf:
    name:
      - fontconfig
    state: present

- name: Import Jenkins repository GPG key
  ansible.builtin.rpm_key:
    key: "{{ jenkins_key_url }}"
    state: present


- name: Add Jenkins LTS repository
  ansible.builtin.get_url:
    url: "{{ jenkins_repo_url }}"
    dest: /etc/yum.repos.d/jenkins.repo
    mode: "0644"


- name: Install Jenkins LTS
  ansible.builtin.dnf:
    name: jenkins
    state: present


# =========================================================
# Jenkins 사용자 설정
# =========================================================

- name: Add Jenkins user to docker group
  ansible.builtin.user:
    name: jenkins
    groups: docker
    append: true
  notify: Restart Jenkins


# =========================================================
# Jenkins systemd 환경 설정
# =========================================================

- name: Create Jenkins systemd override directory
  ansible.builtin.file:
    path: /etc/systemd/system/jenkins.service.d
    state: directory
    mode: "0755"


- name: Configure Jenkins systemd environment
  ansible.builtin.copy:
    dest: /etc/systemd/system/jenkins.service.d/override.conf
    mode: "0644"
    content: |
      [Service]
      Environment="PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin"
      Environment="CASC_JENKINS_CONFIG={{ jenkins_casc_file }}"
  notify: Restart Jenkins


# =========================================================
# Jenkins 서비스 시작
# =========================================================

- name: Enable and start Jenkins service
  ansible.builtin.systemd_service:
    name: jenkins
    enabled: true
    state: started
    daemon_reload: true


# =========================================================
# Jenkins Plugins
# =========================================================

- name: Check installed Jenkins plugins
  ansible.builtin.shell: |
    test -f "/var/lib/jenkins/plugins/{{ item }}.jpi" \
    || test -f "/var/lib/jenkins/plugins/{{ item }}.hpi"
  loop: "{{ jenkins_plugins }}"
  register: jenkins_plugin_check
  changed_when: false
  failed_when: false
  check_mode: false


- name: Install missing Jenkins plugins
  community.general.jenkins_plugin:
    name: "{{ item.item }}"
    state: present
    with_dependencies: true

    jenkins_home: /var/lib/jenkins
    owner: jenkins
    group: jenkins

    url: "{{ jenkins_api_url }}"
    url_username: "{{ jenkins_admin_user }}"
    url_password: "{{ jenkins_api_token }}"
    force_basic_auth: true

  loop: "{{ jenkins_plugin_check.results }}"
  loop_control:
    label: "{{ item.item }}"
  when:
    - item.rc != 0
    - not ansible_check_mode
  notify: Restart Jenkins

# =========================================================
# Jenkins Configuration as Code
# =========================================================

- name: Create Jenkins JCasC directory
  ansible.builtin.file:
    path: "{{ jenkins_casc_dir }}"
    state: directory
    owner: jenkins
    group: jenkins
    mode: "0750"


- name: Deploy Jenkins JCasC configuration
  ansible.builtin.template:
    src: jenkins.yaml.j2
    dest: "{{ jenkins_casc_file }}"
    owner: jenkins
    group: jenkins
    mode: "0640"
  notify: Restart Jenkins


# =========================================================
# Jenkins Credentials
# =========================================================

- name: Configure Jenkins credentials
  community.general.jenkins_script:
    script: "{{ lookup('ansible.builtin.file', role_path + '/files/manage_credentials.groovy') }}"

    args:
      docker_credential_id: "{{ jenkins_dockerhub_credential_id }}"
      docker_username: "{{ dockerhub_username }}"
      docker_token: "{{ vault_dockerhub_token }}"

      gitops_credential_id: "{{ jenkins_gitops_credential_id }}"
      gitops_private_key: "{{ vault_gitops_private_key }}"

    url: "{{ jenkins_api_url }}"
    user: "{{ jenkins_admin_user }}"
    password: "{{ jenkins_api_token }}"

  register: jenkins_credentials_result

  changed_when: >
    (jenkins_credentials_result.output | default('') | trim) == 'CHANGED'

  no_log: true
  become: false


# =========================================================
# Jenkins Firewall
# =========================================================

- name: Check Jenkins firewall port
  ansible.builtin.command:
    cmd: "firewall-cmd --permanent --query-port={{ jenkins_port }}/tcp"
  register: jenkins_firewall_check
  changed_when: false
  failed_when: false


- name: Open Jenkins firewall port
  ansible.builtin.command:
    cmd: "firewall-cmd --permanent --add-port={{ jenkins_port }}/tcp"
  when: jenkins_firewall_check.rc != 0
  notify: Reload firewalld
   
# ------------------------------------------------------------
# Jenkins Pipeline Job
# ------------------------------------------------------------


# 현재 Job 존재 여부 확인
- name: Check NeuroPlan Jenkins pipeline job
  ansible.builtin.uri:
    url: "{{ jenkins_api_url }}/job/{{ jenkins_job_name }}/config.xml"
    method: GET
    url_username: "{{ jenkins_admin_user }}"
    url_password: "{{ jenkins_api_token }}"
    force_basic_auth: true
    return_content: true
    status_code:
      - 200
      - 404
  register: jenkins_job_check
  changed_when: false
  check_mode: false
  no_log: true
  become: false

# Ansible 템플릿의 원하는 Jenkins Job 설정 생성
- name: Render desired NeuroPlan Jenkins pipeline configuration
  ansible.builtin.set_fact:
    jenkins_desired_config: >-
      {{
        lookup('ansible.builtin.template', 'neuroplan-ci.xml.j2')
        | regex_replace('plugin="workflow-job@[^"]+"', 'plugin="workflow-job"')
        | regex_replace('plugin="workflow-cps@[^"]+"', 'plugin="workflow-cps"')
        | regex_replace('plugin="git@[^"]+"', 'plugin="git"')
        | regex_replace('>\\s+<', '><')
        | trim
      }}
  no_log: true


# Jenkins에 현재 존재하는 Job 설정 정규화
- name: Normalize current NeuroPlan Jenkins pipeline configuration
  ansible.builtin.set_fact:
    jenkins_current_config: >-
      {{
        jenkins_job_check.content
        | regex_replace('plugin="workflow-job@[^"]+"', 'plugin="workflow-job"')
        | regex_replace('plugin="workflow-cps@[^"]+"', 'plugin="workflow-cps"')
        | regex_replace('plugin="git@[^"]+"', 'plugin="git"')
        | regex_replace('>\\s+<', '><')
        | trim
      }}
  when: jenkins_job_check.status == 200
  no_log: true


# ------------------------------------------------------------
# Job 생성
# 존재하지 않을 때만 실제 실행
# Check Mode에서는 실행하지 않음
# ------------------------------------------------------------

- name: Create NeuroPlan Jenkins pipeline job
  ansible.builtin.uri:
    url: "{{ jenkins_api_url }}/createItem?name={{ jenkins_job_name }}"
    method: POST
    url_username: "{{ jenkins_admin_user }}"
    url_password: "{{ jenkins_api_token }}"
    force_basic_auth: true
    headers:
      Content-Type: "application/xml"
    body: "{{ lookup('ansible.builtin.template', 'neuroplan-ci.xml.j2') }}"
    status_code:
      - 200
      - 201
  when:
    - jenkins_job_check.status == 404
    - not ansible_check_mode
  no_log: true
  become: false


# ------------------------------------------------------------
# Job 업데이트
# Job이 존재하면서 실제 설정이 다를 때만 실행
# ------------------------------------------------------------

- name: Update NeuroPlan Jenkins pipeline job
  ansible.builtin.uri:
    url: "{{ jenkins_api_url }}/job/{{ jenkins_job_name }}/config.xml"
    method: POST
    url_username: "{{ jenkins_admin_user }}"
    url_password: "{{ jenkins_api_token }}"
    force_basic_auth: true
    headers:
      Content-Type: "application/xml"
    body: "{{ lookup('ansible.builtin.template', 'neuroplan-ci.xml.j2') }}"
    status_code:
      - 200
  when:
    - jenkins_job_check.status == 200
    - jenkins_current_config != jenkins_desired_config
    - not ansible_check_mode
  no_log: true
  become: false


# ------------------------------------------------------------
# Check Mode 결과
# ------------------------------------------------------------

- name: Show Jenkins pipeline job validation result
  ansible.builtin.debug:
    msg: >-
      {% if jenkins_job_check.status == 404 %}
      Jenkins job '{{ jenkins_job_name }}' does not exist and would be CREATED.
      {% elif jenkins_current_config != jenkins_desired_config %}
      Jenkins job '{{ jenkins_job_name }}' exists but configuration differs and would be UPDATED.
      {% else %}
      Jenkins job '{{ jenkins_job_name }}' exists and configuration is synchronized.
      {% endif %}
  changed_when: >-
    jenkins_job_check.status == 404 or
    (
      jenkins_job_check.status == 200 and
      jenkins_current_config != jenkins_desired_config
    )
  when: ansible_check_mode   
